
# ============================================================
# PYTHON
# ============================================================

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/

# Ambientes virtuais
.venv/
venv/
env/

# Arquivos de cobertura
.coverage
htmlcov/

# ============================================================
# CREDENCIAIS E VARIAVEIS DE AMBIENTE
# ============================================================

.env
.env.*
**/.env
**/.env.*

# Exemplos de configuracao podem ir ao GitHub
!.env.example
!**/.env.example

# Chaves e certificados privados
*.pem
*.key
*.p12
*.pfx

# ============================================================
# BANCO DE DADOS SQLITE
# ============================================================

# O banco principal FAZ PARTE da entrega academica.
# data/entrevistas.db deve permanecer versionado.

# Arquivos temporarios criados pelo SQLite
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Backups temporarios (nao o banco principal)
backup_*.db
*_backup.db
backup_*.sqlite
backup_*.sqlite3

# ============================================================
# NODE / REACT / VITE
# ============================================================

node_modules/
dist/
*.tsbuildinfo

# ============================================================
# LOGS E ARQUIVOS TEMPORARIOS
# ============================================================

*.log
logs/

npm-debug.log*
yarn-debug.log*
yarn-error.log*

*.tmp
*.temp
*.bak
*.backup
*~

# ============================================================
# EDITORES E SISTEMA OPERACIONAL
